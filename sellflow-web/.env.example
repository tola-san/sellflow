# Laravel API base URL. Do not include a trailing slash.
# Local development:
VITE_API_URL=http://127.0.0.1:8000/api/v1
#
# Set the deployed Laravel URL in your hosting provider's environment instead:
# VITE_API_URL=https://your-api.example.com/api/v1

# Laravel Reverb. Use the public Reverb hostname in production.
VITE_REVERB_APP_KEY=replace-with-the-public-reverb-app-key
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
